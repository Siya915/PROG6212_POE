@model List<EnrolmentDto>
@{ViewData["Title"]="Participant dashboard";var events=ViewBag.Events as List<EventDto>??new();}
<h1 class="page-title">Your running dashboard</h1><p class="text-muted">Track your upcoming races and personal progress.</p><div class="row g-3 mb-4"><div class="col-md-4"><div class="card metric p-3"><div class="text-muted">My enrolments</div><div class="display-5 fw-bold">@Model.Count(x=>x.Status=="Confirmed")</div></div></div><div class="col-md-4"><div class="card metric p-3"><div class="text-muted">Results recorded</div><div class="display-5 fw-bold">@Model.Count(x=>x.HasResult)</div></div></div><div class="col-md-4"><div class="card metric p-3"><div class="text-muted">Events to explore</div><div class="display-5 fw-bold">@events.Count(x=>x.Status=="Open")</div></div></div></div><h2 class="h4">Your next races</h2><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Event</th><th>Category</th><th>Date joined</th><th>Status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="badge @(e.Status=="Confirmed"?"status-confirmed":"status-cancelled")">@e.Status</span></td></tr>}</tbody></table></div><a class="btn btn-warning" asp-controller="Events" asp-action="Index">Find another event</a>
