@model List<EnrolmentDto>
@{ViewData["Title"]="My events";}<h1 class="page-title mb-3">My event enrolments</h1><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Event</th><th>Event date</th><th>Category</th><th>Enrolled</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="badge @(e.Status=="Confirmed"?"status-confirmed":"status-cancelled")">@e.Status</span></td><td>@if(e.Status=="Confirmed"&&e.EventDate.Date>DateTime.Today){<form asp-action="CancelEnrolment" method="post"><input type="hidden" name="id" value="@e.EnrolmentID"/><button class="btn btn-sm btn-outline-danger">Cancel enrolment</button></form>}</td></tr>}</tbody></table></div>
