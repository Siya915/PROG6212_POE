@model List<ResultDto>
@{ViewData["Title"]="My results";}<h1 class="page-title mb-3">My race history</h1><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Points</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.EventName</td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.CategoryName</td><td>@(r.FinishTime?.ToString(@"hh\:mm\:ss")??"—")</td><td>@r.PositionLabel</td><td>@(r.Points?.ToString()??"—")</td></tr>}</tbody></table></div>
