@model EventDto
@{ViewData["Title"]=Model.EventName;}
<div class="card event-card"><div class="row g-0">@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<div class="col-lg-5"><img src="@Model.BannerImageUrl" class="w-100 h-100 object-fit-cover" alt="Event banner"/></div>}<div class="col"><div class="card-body p-4"><span class="badge text-bg-primary">@Model.Status</span><h1 class="page-title mt-2">@Model.EventName</h1><p class="text-muted">@Model.EventDate.ToString("dddd, dd MMMM yyyy") at @Model.StartTime.ToString(@"hh\:mm")</p><p><strong>Event type:</strong> @Model.EventType</p><p><strong>Venue:</strong> @Model.Venue</p><p>@Model.Description</p><p><strong>Places:</strong> @Model.EnrolmentCount / @Model.Capacity</p><h5>Available categories</h5><ul>@foreach(var c in Model.Categories){<li>@c.CategoryName</li>}</ul>
@if(Context.Session.GetString("Role")=="Participant"&&Model.Status=="Open"&&Model.EventDate.Date>=DateTime.Today){<form asp-controller="Events" asp-action="Enrol" method="post"><input type="hidden" name="EventID" value="@Model.EventID"/><label class="form-label" for="CategoryID">Choose your category</label><select name="CategoryID" id="CategoryID" class="form-select mb-3" required>@foreach(var c in Model.Categories){<option value="@c.CategoryID">@c.CategoryName</option>}</select><button class="btn btn-warning fw-bold">Enrol for this event</button></form>}
else if(Context.Session.GetInt32("UserID")==null){<a class="btn btn-primary" asp-controller="Auth" asp-action="Login">Log in to enrol</a>}
</div></div></div></div>
