@model List<EventDto>
@{ViewData["Title"]="Events";var selectedType=ViewBag.EventType as string;var selectedStatus=ViewBag.Status as string;}<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h1 class="page-title h2">Find your next race</h1><p class="text-muted mb-0">Browse available events and race categories.</p></div><form method="get" class="row g-2"><div class="col-12"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search event or venue"/></div><div class="col"><select name="eventType" class="form-select"><option value="">All event types</option><option selected="@(selectedType=="Road Race"?"selected":null)">Road Race</option><option selected="@(selectedType=="Fun Run"?"selected":null)">Fun Run</option><option selected="@(selectedType=="Trail Run"?"selected":null)">Trail Run</option><option selected="@(selectedType=="Half Marathon"?"selected":null)">Half Marathon</option><option selected="@(selectedType=="Marathon"?"selected":null)">Marathon</option></select></div><div class="col"><select name="status" class="form-select"><option value="">All statuses</option><option selected="@(selectedStatus=="Open"?"selected":null)">Open</option><option selected="@(selectedStatus=="Completed"?"selected":null)">Completed</option><option selected="@(selectedStatus=="Closed"?"selected":null)">Closed</option></select></div><div class="col-auto"><button class="btn btn-primary">Filter</button></div></form></div>
@if(ViewBag.Error!=null){<div class="alert alert-warning">@ViewBag.Error</div>}<div class="row g-3">@foreach(var e in Model){<div class="col-md-6 col-xl-4"><div class="card event-card">@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img class="event-banner" src="@e.BannerImageUrl" alt="Event banner"/>}else{<div class="event-banner d-flex align-items-center justify-content-center display-4">🏁</div>}<div class="card-body"><div class="d-flex justify-content-between"><span class="badge text-bg-primary">@e.Status</span><span class="small text-muted">@e.EnrolmentCount / @e.Capacity places</span></div><h5 class="mt-2">@e.EventName</h5><p class="text-muted small">@e.EventDate.ToString("dd MMM yyyy") · @e.StartTime.ToString(@"hh\:mm")</p><p><span class="badge text-bg-light">@e.EventType</span> · @e.Venue</p><div class="mb-3">@foreach(var c in e.Categories){<span class="badge text-bg-light me-1">@c.CategoryName</span>}</div><a class="btn btn-primary" asp-action="Details" asp-route-id="@e.EventID">View details</a></div></div></div>}</div>
