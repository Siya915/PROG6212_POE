@model List<EventDto>
@{ViewData["Title"]="Home";var selectedType=ViewBag.EventType as string;var selectedStatus=ViewBag.Status as string;}
<section class="hero mb-4"><div class="row align-items-center"><div class="col-lg-8"><span class="badge text-bg-warning mb-3">RUN · COMPETE · CONNECT</span><h1 class="display-4">Your next finish line starts here.</h1><p class="lead">Discover local races, choose your distance and keep your running journey moving.</p><a class="btn btn-warning btn-lg fw-bold" asp-controller="Events" asp-action="Index">Explore events</a></div><div class="col-lg-4 text-center display-1">🏃🏽‍♀️</div></div></section>
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="page-title h3">Upcoming events</h2><a asp-controller="Events" asp-action="Index">View all</a></div>
<form method="get" class="row g-2 mb-4"><div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search event or venue"/></div><div class="col-md-3"><select name="eventType" class="form-select"><option value="">All event types</option><option selected="@(selectedType=="Road Race"?"selected":null)">Road Race</option><option selected="@(selectedType=="Fun Run"?"selected":null)">Fun Run</option><option selected="@(selectedType=="Trail Run"?"selected":null)">Trail Run</option><option selected="@(selectedType=="Half Marathon"?"selected":null)">Half Marathon</option><option selected="@(selectedType=="Marathon"?"selected":null)">Marathon</option></select></div><div class="col-md-2"><select name="status" class="form-select"><option value="">All statuses</option><option selected="@(selectedStatus=="Open"?"selected":null)">Open</option><option selected="@(selectedStatus=="Completed"?"selected":null)">Completed</option><option selected="@(selectedStatus=="Closed"?"selected":null)">Closed</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Filter</button></div></form>
@if(ViewBag.Error!=null){<div class="alert alert-warning">@ViewBag.Error</div>}
<div class="row g-3">@foreach(var e in Model.Where(x=>x.EventDate.Date>=DateTime.Today)){<div class="col-md-6 col-xl-4"><div class="card event-card">@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img class="event-banner" src="@e.BannerImageUrl" alt="Event banner"/>}else{<div class="event-banner d-flex align-items-center justify-content-center display-4">🏁</div>}<div class="card-body"><span class="badge text-bg-primary mb-2">@e.Status</span><h5>@e.EventName</h5><p class="text-muted small mb-1">@e.EventDate.ToString("dd MMM yyyy") · @e.StartTime.ToString(@"hh\:mm")</p><p class="mb-3"><span class="badge text-bg-light">@e.EventType</span> · @e.Venue</p><div class="mb-3">@foreach(var c in e.Categories){<span class="badge text-bg-light me-1">@c.CategoryName</span>}</div><a class="btn btn-primary" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID">Event details</a></div></div></div>}</div>
