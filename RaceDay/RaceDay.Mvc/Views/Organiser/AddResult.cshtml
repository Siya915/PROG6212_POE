@model ResultFormViewModel
@{ViewData["Title"]="Record result";var e=ViewBag.Enrolment as EnrolmentDto;}<div class="card form-card p-4"><h1 class="page-title h3">Record race result</h1><p class="text-muted">@e?.ParticipantName · @e?.EventName · @e?.CategoryName</p><form asp-controller="Organiser" asp-action="AddResult" method="post"><input asp-for="EnrolmentID" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="FinishTime" class="form-label">Finish time (hh:mm:ss)</label><input asp-for="FinishTime" class="form-control" placeholder="00:45:30"/></div><div class="mb-3"><label asp-for="Position" class="form-label">Finishing position</label><input asp-for="Position" class="form-control"/><span asp-validation-for="Position" class="text-danger"></span></div><div class="mb-3"><label asp-for="TotalFinishers" class="form-label">Total number of finishers</label><input asp-for="TotalFinishers" class="form-control"/><span asp-validation-for="TotalFinishers" class="text-danger"></span></div><div class="mb-3"><label asp-for="Points" class="form-label">Points</label><input asp-for="Points" class="form-control"/></div><button class="btn btn-primary">Publish result</button><a asp-action="Enrolments" class="btn btn-outline-secondary">Cancel</a></form></div>
