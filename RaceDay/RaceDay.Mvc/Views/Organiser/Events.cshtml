@model List<EventDto>
@{ViewData["Title"]="Manage events";}<div class="d-flex justify-content-between mb-3"><h1 class="page-title">Manage events</h1><a class="btn btn-warning" asp-action="CreateEvent">+ New event</a></div><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Event</th><th>Date</th><th>Venue</th><th>Places</th><th>Categories</th><th>Actions</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Venue</td><td>@e.EnrolmentCount/@e.Capacity</td><td>@string.Join(", ",e.Categories.Select(c=>c.CategoryName))</td><td class="text-nowrap"><a asp-action="EditEvent" asp-route-id="@e.EventID">Edit</a> · <a asp-action="ManageEventCategories" asp-route-id="@e.EventID">Categories</a> <form asp-action="DeleteEvent" method="post" class="d-inline"><input type="hidden" name="id" value="@e.EventID"/><button class="btn btn-link text-danger p-0" onclick="return confirm('Delete this event?')">Delete</button></form></td></tr>}</tbody></table></div>
