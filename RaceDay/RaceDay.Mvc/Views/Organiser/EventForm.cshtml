@model EventFormViewModel
@{ViewData["Title"]=Model.EventID==0?"Create event":"Edit event";var action=Model.EventID==0?"CreateEvent":"EditEvent";}<div class="card form-card p-4"><h1 class="page-title h3">@ViewData["Title"]</h1><form asp-action="@action" method="post" enctype="multipart/form-data"><input asp-for="EventID" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control"/><span asp-validation-for="EventName" class="text-danger"></span></div><div class="mb-3"><label asp-for="EventType" class="form-label">Event type</label><select asp-for="EventType" class="form-select"><option>Road Race</option><option>Fun Run</option><option>Trail Run</option><option>Half Marathon</option><option>Marathon</option><option>Charity Run</option></select><span asp-validation-for="EventType" class="text-danger"></span></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" class="form-control"/><span asp-validation-for="EventDate" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" class="form-control"/><span asp-validation-for="StartTime" class="text-danger"></span></div></div><div class="mb-3"><label asp-for="Venue" class="form-label"></label><input asp-for="Venue" class="form-control"/><span asp-validation-for="Venue" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="mb-3"><label asp-for="Capacity" class="form-label"></label><input asp-for="Capacity" class="form-control"/><span asp-validation-for="Capacity" class="text-danger"></span></div><div class="mb-3"><label asp-for="BannerImage" class="form-label">Event banner (JPG, PNG or WEBP; max 5 MB)</label><input asp-for="BannerImage" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/></div><button class="btn btn-primary">Save event</button> <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a></form></div>
