@model List<CategoryDto>
@{ViewData["Title"]="Categories";}<h1 class="page-title mb-3">Category management</h1><div class="row g-4"><div class="col-lg-5"><div class="card p-3"><h5>Add a category</h5><form asp-action="CreateCategory" method="post"><div class="mb-2"><label class="form-label">Category name</label><input name="CategoryName" class="form-control" required maxlength="80"/></div><div class="mb-3"><label class="form-label">Description</label><textarea name="Description" class="form-control"></textarea></div><button class="btn btn-primary">Add category</button></form></div></div><div class="col-lg-7"><div class="card p-3"><h5>Available categories</h5><table class="table"><thead><tr><th>Name</th><th>Description</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CategoryName</td><td>@c.Description</td><td><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.CategoryID"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div></div>
