@model List<EnrolmentDto>
@{ViewData["Title"]="Enrolments";}<h1 class="page-title mb-3">Event enrolments</h1><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Participant</th><th>Event</th><th>Event date</th><th>Category</th><th>Date joined</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="badge @(e.Status=="Confirmed"?"status-confirmed":"status-cancelled")">@e.Status</span></td><td>@if(e.Status=="Confirmed"&&e.EventDate.Date<=DateTime.Today){<a asp-action="AddResult" asp-route-enrolmentId="@e.EnrolmentID">Record result</a>} @if(e.Status=="Confirmed"&&e.EventDate.Date>DateTime.Today){<form asp-action="CancelEnrolment" method="post" class="d-inline"><input type="hidden" name="id" value="@e.EnrolmentID"/><button class="btn btn-link text-danger">Cancel</button></form>}</td></tr>}</tbody></table></div>
