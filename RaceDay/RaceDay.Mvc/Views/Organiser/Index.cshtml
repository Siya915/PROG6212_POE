@model List<EventDto>
@{ViewData["Title"]="Organiser dashboard";var enrolments=ViewBag.Enrolments as List<EnrolmentDto>??new();}
<div class="mb-4"><h1 class="page-title">Organiser dashboard</h1><p class="text-muted">Manage your races, participants and results from one place.</p></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card metric p-3"><div class="text-muted">My events</div><div class="display-5 fw-bold">@Model.Count</div></div></div><div class="col-md-4"><div class="card metric p-3"><div class="text-muted">Confirmed enrolments</div><div class="display-5 fw-bold">@enrolments.Count(x=>x.Status=="Confirmed")</div></div></div><div class="col-md-4"><div class="card metric p-3"><div class="text-muted">Upcoming events</div><div class="display-5 fw-bold">@Model.Count(x=>x.EventDate.Date>=DateTime.Today)</div></div></div></div>
<div class="d-flex justify-content-between mb-3"><h2 class="h4">Your events</h2><a class="btn btn-warning" asp-action="CreateEvent">+ Create event</a></div><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Event</th><th>Date</th><th>Enrolments</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.EnrolmentCount / @e.Capacity</td><td>@e.Status</td><td><a asp-action="EditEvent" asp-route-id="@e.EventID">Edit</a></td></tr>}</tbody></table></div>
