@model List<CategoryDto>
@{ViewData["Title"]="Event categories";var eventItem=ViewBag.Event as EventDto;var all=ViewBag.AllCategories as List<CategoryDto>??new();var assigned=Model.Select(x=>x.CategoryID).ToHashSet();}
<h1 class="page-title">Categories for @eventItem?.EventName</h1><div class="row g-4"><div class="col-md-6"><div class="card p-3"><h5>Assigned categories</h5>@if(Model.Count==0){<p class="text-muted">No categories assigned yet.</p>}@foreach(var c in Model){<div class="d-flex justify-content-between border-bottom py-2"><span>@c.CategoryName</span><form asp-action="RemoveEventCategory" method="post"><input type="hidden" name="eventId" value="@eventItem?.EventID"/><input type="hidden" name="categoryId" value="@c.CategoryID"/><button class="btn btn-sm btn-outline-danger">Remove</button></form></div>}</div></div><div class="col-md-6"><div class="card p-3"><h5>Assign a category</h5><form asp-action="AssignCategory" method="post"><input type="hidden" name="eventId" value="@eventItem?.EventID"/><label class="form-label">Category</label><select name="categoryId" class="form-select mb-3" required>@foreach(var c in all.Where(x=>!assigned.Contains(x.CategoryID))){<option value="@c.CategoryID">@c.CategoryName</option>}</select><button class="btn btn-primary">Assign category</button></form></div></div></div><a asp-action="Events" class="btn btn-outline-secondary mt-3">Back to events</a>
